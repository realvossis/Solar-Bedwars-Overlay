{
  "name": "solar-overlay",
  "version": "1.2.6",
  "description": "Custom Hypixel Bedwars overlay (Cubelify-style) with Urchin blacklist integration, screen-capture hiding, and a self-hosted sniper/threat score.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node test/run.js",
    "dist": "electron-builder --win"
  },
  "author": "Nath (realvossis)",
  "repository": {
    "type": "git",
    "url": "https://github.com/realvossis/Solar-Bedwars-Overlay.git"
  },
  "homepage": "https://github.com/realvossis/Solar-Bedwars-Overlay",
  "license": "MIT",
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "gg.solar.overlay",
    "productName": "Solar Overlay",
    "files": [
      "src/**/*",
      "data/**/*",
      "assets/**/*",
      "package.json",
      "!src/main/secrets.js"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon-256.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  }
}
